BACKUP ~weidu_external/PartyToDieFor/backup~
AUTHOR ~Glittergear~
VERSION ~1.1~

README ~PartyToDieFor/PartyToDieFor.txt~

ALWAYS


	ACTION_IF GAME_IS ~bgee~ BEGIN

		INCLUDE ~BloodAndFaith/lib/g3_bgee_cpmvars.tpa~
		PRINT ~Game is bgee~

	END ELSE ACTION_IF GAME_IS ~eet~ BEGIN

		INCLUDE ~eet/other/cpmvars/eet_cpmvars.tpa~
		PRINT ~Game is EET~


	END ELSE ACTION_IF GAME_IS ~bgt~ BEGIN

		INCLUDE ~BloodAndFaith/lib/g3_bgt_cpmvars.tpa~
		PRINT ~Game is BGT~

	END

    //Copies tra files into the autotra-folder (to leave the originals untouched)
    DEFINE_ACTION_FUNCTION autotra_workaround BEGIN
      COPY ~PartyToDieFor/Languages/english~			~weidu_external/PartyToDieFor/Languages/autotra/%LANGUAGE%~
      COPY ~PartyToDieFor/Languages/%LANGUAGE%~			~weidu_external/PartyToDieFor/Languages/autotra/%LANGUAGE%~
    END

    LAF autotra_workaround END

// Convert tra files in UTF8 if EE and let them in ANSI if oBG

	ACTION_IF GAME_IS ~bgee eet~ BEGIN
//  ACTION_DEFINE_ARRAY PartyToDieFor_noconvert BEGIN install END

		ACTION_DEFINE_ARRAY PartyToDieFor_reload BEGIN setup END

			LAF HANDLE_CHARSETS
				INT_VAR
				infer_charsets = 1
				STR_VAR
				tra_path = EVAL ~weidu_external/PartyToDieFor/Languages/autotra~
				out_path = EVAL ~weidu_external/PartyToDieFor/Languages/autotra/UTF8~
				iconv_path = ~PartyToDieFor/Languages/autotra/iconv~
//				 noconvert_array = PartyToDieFor_noconvert
				reload_array = PartyToDieFor_reload
			END

	// UTF8 only
	COPY ~weidu_external/PartyToDieFor/Languages/autotra/UTF8/%LANGUAGE%~				~weidu_external/PartyToDieFor/Languages/autotra/%LANGUAGE%~
	COPY ~weidu_external/PartyToDieFor/Languages/autotra/UTF8/%LANGUAGE%/Dlg~			~weidu_external/PartyToDieFor/Languages/autotra/%LANGUAGE%/Dlg~
	END

END

AUTO_TRA ~weidu_external/PartyToDieFor/Languages/autotra/%s~


LANGUAGE ~English~
         ~english~
         ~PartyToDieFor/Languages/english/setup.tra~

LANGUAGE ~Russian (by CblblP & Arcanecoast.ru)~
         ~russian~
         ~PartyToDieFor/Languages/english/setup.tra~
         ~PartyToDieFor/Languages/russian/setup.tra~


BEGIN  @1 /* A Party to Die For */
DESIGNATED 0
LABEL ~A-Party_to-Die-For-Glittergear~
REQUIRE_PREDICATE GAME_IS ~bgee eet bgt~ @0 /* This mod need BGEE, BGT or EET */

LAF HANDLE_AUDIO END
ADD_MUSIC ~g_mmBG~ ~%MOD_FOLDER%/music/g_mmBG.mus~
ADD_MUSIC ~g_mmFi~ ~%MOD_FOLDER%/music/g_mmFi.mus~


COPY ~%MOD_FOLDER%/music/g_mmBGa.acm~ ~MUSIC/g_mmBG/g_mmBGa.acm~
COPY ~%MOD_FOLDER%/music/g_mmFia.acm~ ~MUSIC/g_mmFi/g_mmFia.acm~

COPY ~%MOD_FOLDER%/music/g_mmFig.ogg~ ~MUSIC/g_mmFig/g_mmFig.ogg~
