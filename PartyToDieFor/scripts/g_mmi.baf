//////////////////////////////////////
// FOG
//////////////////////////////////////

IF
	OnCreation()
THEN
	RESPONSE #100
		Explore()
		Weather(FOG)
		Continue()
END

IF
	PartyRested()
THEN
  RESPONSE #100
		Weather(FOG)
		Continue()
END

//////////////////////////////////////
// ARRIVAL
//////////////////////////////////////

IF
	Global("gAdrikSp2","MYAREA",0)
THEN
	RESPONSE #100
		CreateCreature("g_mmia2",[1260.2616],3)  
		SetGlobal("gAdrikSp2","MYAREA",1)
		Continue()
END

