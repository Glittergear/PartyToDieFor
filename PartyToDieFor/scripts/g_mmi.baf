//////////////////////////////////////
// LAST ONE STANDING: TENADAR
//////////////////////////////////////
IF
	Global("g_mmCh","GLOBAL",1)
	Global("g_mmChs","MYAREA",0)
THEN
	RESPONSE #100
		//	PlaySong(0)
		//	PlaySound("g_mmFig")
		CreateCreature("g_mmteK",[3377.1566],3)  //Tenadar killer
		CreateCreature("g_mmDrD",[3371.1455],3)  //dead Drunlo
		CreateCreature("g_mmtrD",[3410.1492],3)  //dead Tremona
	//	ActionOverride("g_mmteK",StartDialogueNoSet(Player1)
	//	ActionOverride("g_mmteK", Enemy())
		SetGlobal("g_mmChs","MYAREA",1)
		Continue()
END

