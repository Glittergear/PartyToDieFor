//////////////////////////////////////
// FIST APPEARS
//////////////////////////////////////
IF
	Dead("g_mmMu")
	Global("g_mmChs","MYAREA", 2)
THEN
	RESPONSE #100
		SetGlobal("g_mmChs","MYAREA", 3)
		CreateCreature("g_mmFF",[3184.1455],3)  
		ActionOverride("g_mmFF",StartDialogueNoSet(Player1)
		Continue()
END


