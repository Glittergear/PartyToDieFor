//////////////////////////////////////////////
// ZASHIR APPEARS ON TIME - TENADAR WAS LAST
//////////////////////////////////////////////
IF
	Global("g_mmCh","GLOBAL",1)
	Global("g_mmChs","MYAREA",1)
	Dead("g_mmteK") //make tenK
THEN
	RESPONSE #100
		//	PlaySong(0)
		//	PlaySound("g_mmFig")
		CreateCreature("g_mmMu",[3608.1380],3)  
		//	ActionOverride("g_mmMu",StartDialogueNoSet(Player1)
		//	ActionOverride("g_mmMu", Enemy())
		SetGlobal("g_mmChs","MYAREA",2)
		Continue()
END

